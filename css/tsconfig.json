{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "types": [],
    "paths": {
      "@geastack/core": ["../../examples/node_modules/@geastack/core/index.d.ts"]
    }
  },
  "include": ["shared/**/*.ts", "shared/**/*.tsx", "esp32/**/*.tsx"],
  "exclude": ["**/.gea/**", "**/node_modules/**"]
}
